# =============================================================================
# ARMSS STATIONERY MANAGEMENT — BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=8080
ENV=development


# -----------------------------------------------------------------------------
# DATABASE (MySQL)
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stationery_db


# -----------------------------------------------------------------------------
# JWT AUTH
# -----------------------------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-secret-string
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=168


# =============================================================================
# EMAIL (SMTP) — REMINDER NOTIFICATIONS
# =============================================================================
# The Monitor screen "Send Reminder" feature uses these settings to dispatch
# real emails to Requesters, Approvers, and the Delivery Agency.
#
# If SMTP_HOST or SMTP_USER is left empty, the system falls back to
# MOCK MODE — only prints emails to the server log (safe for local dev).
#
# -- HOW TO SET UP GMAIL SMTP (App Password) ----------------------------------
#
#  STEP 1 — Enable 2-Step Verification on your Google account
#    > https://myaccount.google.com/security
#    > Find "2-Step Verification" and turn it ON
#
#  STEP 2 — Generate an App Password
#    > Go to: https://myaccount.google.com/apppasswords
#    > Select App: "Mail"  |  Device: "Other (custom name)" -> type "ARMSS"
#    > Click "Generate"
#    > Copy the 16-character password shown (e.g. abcd efgh ijkl mnop)
#    > Remove the spaces: it becomes "abcdefghijklmnop"
#
#  STEP 3 — Fill in the values below
#    SMTP_USER     = the Gmail address you generated the App Password from
#    SMTP_PASSWORD = the 16-character App Password (no spaces)
#    SMTP_FROM     = display name + same Gmail address
#
#  EXAMPLE:
#    SMTP_USER=armss.stationery@gmail.com
#    SMTP_PASSWORD=abcdefghijklmnop
#    SMTP_FROM=ARMSS Stationery Management <armss.stationery@gmail.com>
#
#  NOTE: Regular Gmail passwords will NOT work. You must use an App Password.
#        App Passwords are only available when 2FA is enabled.
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=ARMSS Stationery Management <your-gmail-address@gmail.com>
